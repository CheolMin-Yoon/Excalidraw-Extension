{
  "manifest_version": 3,
  "name": "Excalidraw Vector LaTeX",
  "version": "0.2.1",
  "description": "Turn $$...$$ into crisp, transparent vector LaTeX on Excalidraw.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://excalidraw.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:18743/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LaTeX 글꼴"
  }
}
