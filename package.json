{
  "name": "excalidraw-vector-latex",
  "version": "0.2.0",
  "private": true,
  "description": "Render $$...$$ as transparent vector LaTeX in Excalidraw.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "npm run icons && vite build && vite build --config vite.ui.config.ts && node scripts/copy-third-party-licenses.mjs",
    "dev": "vite build --watch",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-extension.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:native && npm run build",
    "test:native": "node --test native/renderer.test.mjs",
    "test:smoke:fonts": "node scripts/smoke-fonts.mjs",
    "dev:ui": "vite build --config vite.ui.config.ts --watch"
  },
  "dependencies": {
    "@mathjax/src": "4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.2.6",
    "@types/node": "24.10.13",
    "eslint": "10.8.1",
    "globals": "17.4.0",
    "jsdom": "30.0.1",
    "playwright-core": "^1.62.1",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
